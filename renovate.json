{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["rpm"],
  "rpm": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "prConcurrentLimit": 100,
  "branchConcurrentLimit": 100,
  "prHourlyLimit": 100,
  "updateNotScheduled": true
}
